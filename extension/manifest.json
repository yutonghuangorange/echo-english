{
  "manifest_version": 3,
  "name": "Echo · 配音与唱歌练习",
  "version": "0.10.0",
  "description": "把喜欢的 YouTube 对白和歌曲变成自己的声音：多语言原文、逐句练习、伴奏录唱和录音对比。",
  "action": {
    "default_title": "打开 / 收起配音练习"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "subtitles.js",
        "transcript.js",
        "dictionary.js",
        "audio-analysis.js",
        "audio-export.js",
        "karaoke.js",
        "practice.js",
        "panel-size.js",
        "storage.js",
        "languages.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "http://127.0.0.1:8765/*"
  ]
}
