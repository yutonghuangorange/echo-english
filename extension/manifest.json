{
  "manifest_version": 3,
  "name": "Echo · 英语配音练习",
  "version": "0.1.1",
  "description": "在 YouTube 上选取片段，听原声、看台词、录制配音并随画面回放对比。",
  "action": {
    "default_title": "打开 / 收起配音练习"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "subtitles.js",
        "transcript.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
